PORT=4000
NODE_ENV=development

# Anthropic Claude
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dev overrides (set to true to bypass auth/payment in development)
DEV_SKIP_AUTH=false
DEV_SKIP_PAYMENT=false
DEV_USER_ID=test-user-123
# CORS allowlist. Use comma-separated URLs when you have multiple frontend domains.
# In non-production, http://localhost:5173 and http://127.0.0.1:5173 are always merged in
# so local Vite still works even if you only list your deployed URL here.
# Examples:
# FRONTEND_URLS=http://localhost:5173,https://yourapp.vercel.app,https://app.yourdomain.com
FRONTEND_URLS=http://localhost:5173
